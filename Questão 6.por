programa {
  funcao inicio() {
    inteiro idade 
    real preco
    cadeia nome
    caracter inicial 
    logico logado
    
    idade=20
    preco=2.99
    nome="Leonardo"
    inicial='L'
    logado=verdadeiro 

    escreva ("Idade:",idade,"\n")
    escreva("Preco:", preco,"\n")
    escreva("Nome:", nome,"\n")
    escreva("Inicial:", inicial,"\n")
    escreva("Logado:", logado,"\n")

  }
}
