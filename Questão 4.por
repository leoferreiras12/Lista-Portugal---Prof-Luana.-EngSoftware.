programa {
  funcao inicio() {
    escreva("---Receita de sanduíche---\n")
    escreva("1 Passo - Pegue o pão\n")
    escreva("2 Passo - Pegue o quieeijo, cheddar ou mussarela\n")
    escreva("3 Passo - Pegue uma proteína de sua preferência (presunto,peito de frango)\n")
    escreva("4 Passo - Pegue alface e tomate\n")
    escreva("5 Passo - Pegue um molho de sua preferência ( maionense, ketchup)/n")
    escreva("6 Passo - Pegue o sanduíche feito e o esquente\n")
    escreva("7 Passo - Agora, Coma e seja feliz.\n")
  }
}
