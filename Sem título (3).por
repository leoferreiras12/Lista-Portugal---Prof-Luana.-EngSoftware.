programa {
  funcao inicio() {
    inteiro opcao
    escreva ("---Desejos da debinha---\n")
    escreva("Escolha uma opção\n")
    escreva("1- Muitos abraços e beijos\n")
    escreva("2- Muito carinho e beijo na testa\n")
    escreva("3- Cafuné e um abraço apertado\n ")
    escreva("4- Dormir abracaçada com meu namorado\n")
    escreva("5- Todas as opções \n")

    escreva("\n Digite o número da sua opção, meu amor<3\n")
    leia (opcao)
    //o 'escolha'deve ficar dentro da função início 
    escolha (opcao)
    {
    caso 1:
    escreva("Você acaba de ganhar muitos abraços e beijos, meu amor<3\n")
    pare
    caso 2:
    escreva("Você acaba de ganhar muito carinho, e beijinho na testa, meu anjinho<2\n")
    caso 3:("Você acaba de ganhar um cafuné muito especial e um abraço muito apedtado, meu bem<3\n")
    pare
    caso 4:("Você vai dormir muito abraçada, e com um abraço bem apertado, neném\n")
    pare 
    caso 5: ("Você vai ter todos eles meu, amorzinho\n")
    caso contrario:
    escreva (" opção inválida, meu amor. Eu te amo:)\n")
    }



    

  }
}
